{
    "name": "htsw",
    "version": "2.0.0",
    "description": "HTSW framework",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./types": {
            "import": "./dist/types/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./runtime": {
            "import": "./dist/runtime/index.js",
            "types": "./dist/runtime/index.d.ts"
        },
        "./runtime/simple": {
            "import": "./dist/runtime/simple/index.js",
            "types": "./dist/runtime/simple/index.d.ts"
        },
        "./nbt": {
            "import": "./dist/nbt/index.js",
            "types": "./dist/nbt/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "knip": "knip",
        "format": "npx prettier \"**/*.{ts,tsx,css,json}\" --write",
        "prepare": "npm run build"
    },
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/LGHousing/htsw.git",
        "directory": "language"
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1",
        "long": "^5.3.2"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "knip": "^6.31.0",
        "prettier": "^3.9.6",
        "typescript": "^7.0.2",
        "vitest": "4.1.10"
    }
}
