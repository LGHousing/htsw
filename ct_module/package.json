{
    "name": "htsw-ct-module",
    "version": "1.1.1",
    "description": "HTSL but we don't take no Ls",
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "type": "module",
    "scripts": {
        "build:java": "node --experimental-strip-types ./scripts/compileJava.ts",
        "check:metadata": "node --experimental-strip-types ./scripts/syncMetadataVersion.ts --check",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
        "knip": "knip",
        "test": "npm run typecheck && vitest run",
        "build": "npm run check:metadata && npm run generate:icons && npm run typecheck && vite build --mode production && npm run build:java",
        "verify": "npm run lint && npm run knip",
        "sync:metadata": "node --experimental-strip-types ./scripts/syncMetadataVersion.ts",
        "generate:icons": "node --experimental-strip-types ./scripts/generateIconsList.ts",
        "generate:condition-mappings": "node --experimental-strip-types ./scripts/generateConditionMappingScaffold.ts",
        "generate:action-mappings": "node --experimental-strip-types ./scripts/generateActionMappingScaffold.ts",
        "format": "npx prettier \"**/*.{ts,json}\" --write"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/LGHousing/htsw.git",
        "directory": "ct_module"
    },
    "dependencies": {
        "htsw": "file:../language",
        "htsw-editor-common": "file:../editors/common",
        "promise-polyfill": "^8.3.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@rollup/plugin-babel": "^7.1.0",
        "@types/node": "^26.1.2",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^10.9.1",
        "knip": "^6.31.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.2.2",
        "vitest": "4.1.10"
    }
}
