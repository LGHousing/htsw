{
    "name": "htsw-ct-module",
    "version": "0.6.3",
    "description": "HTSL but we don't take no Ls",
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "type": "module",
    "scripts": {
        "dev": "npx tsx watch src/testing.ts",
        "build:java": "node --experimental-strip-types ./scripts/compileJava.ts",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
        "knip": "knip",
        "test": "npm run typecheck && vitest run",
        "build": "npm run generate:icons && npm run typecheck && npm run lint && vite build --mode production && npm run build:java",
        "generate:icons": "node --experimental-strip-types ./scripts/generateIconsList.ts",
        "generate:condition-mappings": "node --experimental-strip-types ./scripts/generateConditionMappingScaffold.ts",
        "generate:action-mappings": "node --experimental-strip-types ./scripts/generateActionMappingScaffold.ts",
        "format": "npx prettier \"**/*.{ts,json}\" --write"
    },
    "license": "MIT",
    "dependencies": {
        "htsw": "file:../language",
        "htsw-editor-common": "file:../editors/common",
        "promise-polyfill": "^8.3.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/plugin-proposal-class-properties": "^7.0.0",
        "@babel/plugin-transform-classes": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@rollup/plugin-babel": "^7.1.0",
        "@types/node": "^25.9.3",
        "@vitest/coverage-v8": "^4.1.9",
        "eslint": "^10.5.0",
        "knip": "^6.16.1",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vite": "^8.0.16",
        "vitest": "4.1.9"
    }
}
