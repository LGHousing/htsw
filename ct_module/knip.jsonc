{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "scripts/*.ts",
        "test/**/*.test.ts",
        // The importer's client modules (scripts/importerClientModules.ts): the
        // importer imports them through the resolve plugin, which knip can't see.
        "src/importerPlatform.ts",
        "src/importerClientConformance.ts",
        "src/housingSync/items/capture.ts",
        "src/housingSync/items/heldItem.ts",
        "src/housingSync/items/itemPicker.ts",
        "src/housingSync/items/playerInventory.ts",
        "src/housingSync/menus/menuInput.ts",
        "src/housingSync/sideEffects.ts",
        "src/importables/functions/icon.ts",
        "src/project/htswPath.ts",
        "src/project/projectFs.ts",
        "src/runtime/parsing/realPath.ts",
        "src/runtimeDebug/importFailureLog.ts",
        "src/runtimeDebug/importFailureUpload.ts",
        "src/tasks/specifics/slots.ts",
        "src/tasks/specifics/waitFor.ts",
        "src/trace/jsonl.ts",
        "src/utils/fileLoaders.ts",
        "src/utils/filesystem.ts",
        "src/utils/itemLore.ts",
        "src/utils/mainThread.ts",
        "src/utils/nbt.ts",
        "src/utils/packets.ts",
    ],
    "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
    "ignoreDependencies": ["@babel/preset-env"],
    "ignoreBinaries": ["java", "javac"],
    "ignoreIssues": {
        "src/runtime/queue.ts": ["exports", "types", "duplicates"],
        "src/runtime/queueRunner.ts": ["exports"],
        "src/gui/lib/theme.ts": ["duplicates"],
    },
}
