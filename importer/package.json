{
    "name": "@htsw/importer",
    "version": "1.3.2",
    "description": "Client-agnostic HTSW importer: cache, hydration, diff, plan and import algorithms",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./*": "./src/*.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "check:boundary": "node --experimental-strip-types ./scripts/checkBoundary.ts",
        "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
        "knip": "knip",
        "verify": "npm run typecheck && npm run check:boundary && npm run lint && npm run knip"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/LGHousing/htsw.git",
        "directory": "importer"
    },
    "dependencies": {
        "htsw": "file:../language",
        "htsw-editor-common": "file:../editors/common"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "eslint": "^10.13.0",
        "knip": "^6.31.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2"
    }
}
