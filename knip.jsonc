{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignore": ["docs/**"],
    "ignoreIssues": {
        "ct_module/src/gui/lib/theme.ts": ["duplicates"],
        "ct_module/src/tui/elements.ts": ["exports"]
    },
    "workspaces": {
        ".": {
            "entry": ["vitest.workspace.ts"],
            "ignoreBinaries": ["knip"]
        },
        "ct_module": {
            "entry": ["scripts/*.ts", "test/**/*.test.ts"],
            "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
            "ignoreDependencies": ["@babel/preset-env"],
            "ignoreBinaries": ["javac"]
        },
        "editors/code": {
            "entry": [
                "src/webview/tools/main.ts",
                "src/webview/itemEditor/main.ts",
                "src/webview/soundPreviewer/main.ts"
            ]
        },
        "editors/monaco": {
            "entry": ["src/monaco.contribution.ts"]
        }
    }
}
