{
    "name": "htsw-plus-plus",
    "displayName": "HTSW++",
    "description": "HTSW completions, diagnostics, hints, and more.",
    "version": "2.0.1",
    "publisher": "LGHousing",
    "license": "MIT",
    "type": "module",
    "repository": {
        "url": "https://github.com/LGHousing/htsw"
    },
    "engines": {
        "vscode": "^1.97.2"
    },
    "scripts": {
        "generate:grammar": "node --experimental-strip-types scripts/generateHtslGrammar.mjs",
        "generate:schema": "node --experimental-strip-types scripts/generateImportSchema.ts",
        "build": "npm run generate:grammar && npm run generate:schema && tsc --noEmit && vite build --mode production && vite build --config vite.webview.config.ts --mode production",
        "check:schema": "node --experimental-strip-types scripts/generateImportSchema.ts --check",
        "package:built": "vsce package --no-dependencies",
        "package": "npm run build && npm run package:built"
    },
    "dependencies": {
        "htsw": "file:../../language",
        "htsw-editor-common": "file:../common",
        "jsonc-parser": "^3.3.1",
        "minecraft-icon-items": "^0.4.5",
        "typeface-minecraft": "^1.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/vscode": "^1.97",
        "@vscode/vsce": "^3.6",
        "typescript": "^7.0",
        "vite": "^8.2.0"
    },
    "main": "./dist/extension.cjs",
    "activationEvents": [
        "onStartupFinished",
        "onLanguage:json",
        "onLanguage:jsonc"
    ],
    "contributes": {
        "commands": [
            {
                "command": "htsw.snbt.format",
                "title": "Format SNBT",
                "category": "HTSW"
            },
            {
                "command": "htsw.project.createIncludedImportJson",
                "title": "Create Included import.json",
                "category": "HTSW"
            },
            {
                "command": "htsw.checkForUpdates",
                "title": "Check for Updates",
                "category": "HTSW",
                "icon": "$(cloud-download)"
            },
            {
                "command": "htsw.importable.move",
                "title": "Move to...",
                "category": "HTSW"
            },
            {
                "command": "htsw.importable.rename",
                "title": "Rename",
                "category": "HTSW"
            },
            {
                "command": "htsw.importable.reveal",
                "title": "Reveal in Finder",
                "category": "HTSW"
            },
            {
                "command": "htsw.importable.copyPath",
                "title": "Copy Path",
                "category": "HTSW"
            },
            {
                "command": "htsw.importable.delete",
                "title": "Delete...",
                "category": "HTSW"
            },
            {
                "command": "htsw.importJson.delete",
                "title": "Delete...",
                "category": "HTSW"
            },
            {
                "command": "htsw.menu.addSlot",
                "title": "Add slot...",
                "category": "HTSW"
            },
            {
                "command": "htsw.menuSlot.remove",
                "title": "Remove slot",
                "category": "HTSW"
            },
            {
                "command": "htsw.menu.setSize",
                "title": "Set size...",
                "category": "HTSW"
            },
            {
                "command": "htsw.item.editInItemEditor",
                "title": "Edit in Item Editor",
                "category": "HTSW"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "htsw.checkForUpdates",
                    "when": "view == htsw.tools",
                    "group": "navigation@1"
                }
            ],
            "explorer/context": [
                {
                    "command": "htsw.project.createIncludedImportJson",
                    "group": "htsw@1"
                },
                {
                    "command": "htsw.item.editInItemEditor",
                    "when": "resourceExtname == .snbt",
                    "group": "htsw@2"
                }
            ],
            "editor/context": [
                {
                    "command": "htsw.item.editInItemEditor",
                    "when": "resourceExtname == .snbt",
                    "group": "htsw@1"
                }
            ],
            "webview/context": [
                {
                    "command": "htsw.importable.rename",
                    "when": "webviewId == 'htsw.tools' && webviewSection == 'importable'",
                    "group": "navigation@0"
                },
                {
                    "command": "htsw.importable.move",
                    "when": "webviewId == 'htsw.tools' && webviewSection == 'importable'",
                    "group": "navigation@1"
                },
                {
                    "command": "htsw.importable.delete",
                    "when": "webviewId == 'htsw.tools' && webviewSection == 'importable'",
                    "group": "navigation@2"
                },
                {
                    "command": "htsw.importable.reveal",
                    "when": "webviewId == 'htsw.tools' && webviewSection == 'importable'",
                    "group": "navigation@3"
                },
                {
                    "command": "htsw.importable.copyPath",
                    "when": "webviewId == 'htsw.tools' && webviewSection == 'importable'",
                    "group": "navigation@4"
                },
                {
                    "command": "htsw.importJson.delete",
                    "when": "webviewId == 'htsw.tools' && webviewSection == 'importJson'",
                    "group": "navigation@0"
                },
                {
                    "command": "htsw.menu.addSlot",
                    "when": "webviewId == 'htsw.tools' && webviewSection == 'importable' && importableKind == 'menu'",
                    "group": "navigation@0"
                },
                {
                    "command": "htsw.menu.setSize",
                    "when": "webviewId == 'htsw.tools' && webviewSection == 'importable' && importableKind == 'menu'",
                    "group": "navigation@1"
                },
                {
                    "command": "htsw.menuSlot.remove",
                    "when": "webviewId == 'htsw.tools' && webviewSection == 'menuSlot'",
                    "group": "navigation@0"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "htsw",
                    "title": "HTSW",
                    "icon": "media/htsw-activitybar.svg"
                }
            ]
        },
        "views": {
            "htsw": [
                {
                    "id": "htsw.tools",
                    "type": "webview",
                    "name": "HTSW",
                    "icon": "media/htsw-activitybar.svg"
                }
            ]
        },
        "languages": [
            {
                "id": "htsl",
                "extensions": [
                    ".htsl"
                ],
                "aliases": [
                    "HTSL",
                    "htsl"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "snbt",
                "extensions": [
                    ".snbt"
                ],
                "aliases": [
                    "SNBT",
                    "snbt"
                ],
                "configuration": "./snbt-language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "htsl",
                "scopeName": "source.htsl",
                "path": "./htsl.tmGrammar.json"
            },
            {
                "language": "snbt",
                "scopeName": "source.snbt",
                "path": "./snbt.tmGrammar.json"
            }
        ],
        "jsonValidation": [
            {
                "fileMatch": "import.json",
                "url": "./schemas/import.schema.json"
            },
            {
                "fileMatch": "*.import.json",
                "url": "./schemas/import.schema.json"
            }
        ],
        "configuration": {
            "title": "HTSW++",
            "properties": {
                "htsw.autoUpdate.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Check the latest GitHub Release for HTSW++ updates on startup and offer to install them."
                },
                "htsw.diagnostics.excludeFolders": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Workspace-relative folder prefixes to exclude from HTSW diagnostics."
                },
                "htsw.inlayHints.actionArguments.enabled": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable inlay hints for regular action arguments."
                },
                "htsw.inlayHints.variableArguments.enabled": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Enable inlay hints for `var`, `globalvar`, `teamvar`, and stat-style variable arguments."
                },
                "htsw.inlayHints.conditionArguments.enabled": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable inlay hints for condition arguments."
                },
                "htsw.snbt.suggestLoreSplitting": {
                    "type": "boolean",
                    "default": false,
                    "description": "Offer a code action to split long Lore strings into optimally-sized lines for Minecraft tooltips. When the cursor is on a string inside a Lore: [...] list, a 'Split lore line for optimal display' refactor becomes available."
                },
                "htsw.snbt.loreLineMaxWidth": {
                    "type": "number",
                    "default": 40,
                    "minimum": 8,
                    "description": "Max unformatted character width per Lore line when applying 'Split lore line for optimal display'. Format codes (&a, &7, etc.) are not counted; placeholders like %player.name% are treated as 4-character tokens."
                }
            }
        },
        "configurationDefaults": {
            "editor.tokenColorCustomizations": {
                "textMateRules": [
                    {
                        "scope": "constant.character.format-code.color.black.snbt",
                        "settings": {
                            "foreground": "#000000"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.dark-blue.snbt",
                        "settings": {
                            "foreground": "#0000AA"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.dark-green.snbt",
                        "settings": {
                            "foreground": "#00AA00"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.dark-aqua.snbt",
                        "settings": {
                            "foreground": "#00AAAA"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.dark-red.snbt",
                        "settings": {
                            "foreground": "#AA0000"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.dark-purple.snbt",
                        "settings": {
                            "foreground": "#AA00AA"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.gold.snbt",
                        "settings": {
                            "foreground": "#FFAA00"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.gray.snbt",
                        "settings": {
                            "foreground": "#AAAAAA"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.dark-gray.snbt",
                        "settings": {
                            "foreground": "#555555"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.blue.snbt",
                        "settings": {
                            "foreground": "#5555FF"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.green.snbt",
                        "settings": {
                            "foreground": "#55FF55"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.aqua.snbt",
                        "settings": {
                            "foreground": "#55FFFF"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.red.snbt",
                        "settings": {
                            "foreground": "#FF5555"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.light-purple.snbt",
                        "settings": {
                            "foreground": "#FF55FF"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.yellow.snbt",
                        "settings": {
                            "foreground": "#FFFF55"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.color.white.snbt",
                        "settings": {
                            "foreground": "#FFFFFF"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.style.bold.snbt",
                        "settings": {
                            "fontStyle": "bold"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.style.italic.snbt",
                        "settings": {
                            "fontStyle": "italic"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.style.underline.snbt",
                        "settings": {
                            "fontStyle": "underline"
                        }
                    },
                    {
                        "scope": "constant.character.format-code.style.strikethrough.snbt",
                        "settings": {
                            "fontStyle": "strikethrough"
                        }
                    },
                    {
                        "scope": "meta.format-code.style.bold.snbt",
                        "settings": {
                            "fontStyle": "bold"
                        }
                    },
                    {
                        "scope": "meta.format-code.style.italic.snbt",
                        "settings": {
                            "fontStyle": "italic"
                        }
                    },
                    {
                        "scope": "meta.format-code.style.underline.snbt",
                        "settings": {
                            "fontStyle": "underline"
                        }
                    },
                    {
                        "scope": "meta.format-code.style.strikethrough.snbt",
                        "settings": {
                            "fontStyle": "strikethrough"
                        }
                    }
                ]
            }
        }
    }
}
