{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HTSL import.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "houseUuid": {
      "type": "string",
      "description": "Housing UUID binding. Only the entry import.json's binding is used.",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "include": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/importJsonPath"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/functionImportable"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/eventImportable"
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/regionImportable"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/itemImportable"
      }
    },
    "menus": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/menuImportable"
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/teamImportable"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/groupImportable"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/commandImportable"
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/npcImportable"
      }
    }
  },
  "definitions": {
    "importJsonPath": {
      "type": "string",
      "pattern": "\\.?[iI][mM][pP][oO][rR][tT]\\.json$"
    },
    "htslPath": {
      "type": "string",
      "pattern": "\\.htsl$"
    },
    "snbtPath": {
      "type": "string",
      "pattern": "\\.snbt$"
    },
    "itemName": {
      "type": "string",
      "pattern": "^[^@]*$"
    },
    "functionImportable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "actions": {
          "$ref": "#/definitions/htslPath"
        },
        "description": {
          "type": "string"
        },
        "repeatTicks": {
          "type": "number",
          "minimum": 4,
          "maximum": 18000
        },
        "icon": {
          "$ref": "#/definitions/functionIcon"
        }
      },
      "required": [
        "name"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"name\" }",
          "body": {
            "name": "$1"
          }
        }
      ]
    },
    "functionIcon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "enchanted": {
          "type": "boolean"
        }
      },
      "required": [
        "item"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"item\" }",
          "body": {
            "item": "$1"
          }
        }
      ]
    },
    "eventImportable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "Player Join",
            "Player Quit",
            "Player Death",
            "Player Kill",
            "Player Respawn",
            "Group Change",
            "PvP State Change",
            "Fish Caught",
            "Player Enter Portal",
            "Player Damage",
            "Player Block Break",
            "Start Parkour",
            "Complete Parkour",
            "Player Drop Item",
            "Player Pick Up Item",
            "Player Change Held Item",
            "Player Toggle Sneak",
            "Player Toggle Flight"
          ]
        },
        "actions": {
          "$ref": "#/definitions/htslPath"
        }
      },
      "required": [
        "event",
        "actions"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"event\", \"actions\" }",
          "body": {
            "event": "$1",
            "actions": "$2"
          }
        }
      ]
    },
    "pos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "z": {
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"x\", \"y\", \"z\" }",
          "body": {
            "x": "^$1",
            "y": "^$2",
            "z": "^$3"
          }
        }
      ]
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/definitions/pos"
        },
        "to": {
          "$ref": "#/definitions/pos"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"from\", \"to\" }",
          "body": {
            "from": {
              "x": "^$1",
              "y": "^$2",
              "z": "^$3"
            },
            "to": {
              "x": "^$4",
              "y": "^$5",
              "z": "^$6"
            }
          }
        }
      ]
    },
    "regionImportable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "bounds": {
          "$ref": "#/definitions/bounds"
        },
        "onEnterActions": {
          "$ref": "#/definitions/htslPath"
        },
        "onExitActions": {
          "$ref": "#/definitions/htslPath"
        }
      },
      "required": [
        "name",
        "bounds"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"name\", \"bounds\" }",
          "body": {
            "name": "$1",
            "bounds": {
              "from": {
                "x": "^$2",
                "y": "^$3",
                "z": "^$4"
              },
              "to": {
                "x": "^$5",
                "y": "^$6",
                "z": "^$7"
              }
            }
          }
        }
      ]
    },
    "itemImportable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/definitions/itemName"
        },
        "nbt": {
          "$ref": "#/definitions/snbtPath"
        },
        "leftClickActions": {
          "$ref": "#/definitions/htslPath"
        },
        "rightClickActions": {
          "$ref": "#/definitions/htslPath"
        }
      },
      "required": [
        "name",
        "nbt"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"name\", \"nbt\" }",
          "body": {
            "name": "$1",
            "nbt": "$2"
          }
        }
      ]
    },
    "menuImportable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/menuSlot"
          }
        }
      },
      "required": [
        "name",
        "slots"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"name\", \"slots\" }",
          "body": {
            "name": "$1",
            "slots": []
          }
        }
      ]
    },
    "menuSlot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 53
        },
        "nbt": {
          "$ref": "#/definitions/snbtPath"
        },
        "actions": {
          "$ref": "#/definitions/htslPath"
        }
      },
      "required": [
        "slot",
        "nbt"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"slot\", \"nbt\" }",
          "body": {
            "slot": "^$1",
            "nbt": "$2"
          }
        }
      ]
    },
    "npcSkin": {
      "type": "string",
      "enum": [
        "Steve",
        "Alex",
        "Players Skin"
      ]
    },
    "npcEquipment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "helmet": {
          "$ref": "#/definitions/snbtPath"
        },
        "chestplate": {
          "$ref": "#/definitions/snbtPath"
        },
        "leggings": {
          "$ref": "#/definitions/snbtPath"
        },
        "boots": {
          "$ref": "#/definitions/snbtPath"
        },
        "hand": {
          "$ref": "#/definitions/snbtPath"
        }
      }
    },
    "npcImportable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "pos": {
          "$ref": "#/definitions/pos"
        },
        "leftClickActions": {
          "$ref": "#/definitions/htslPath"
        },
        "rightClickActions": {
          "$ref": "#/definitions/htslPath"
        },
        "leftClickRedirect": {
          "type": "boolean"
        },
        "lookAtPlayers": {
          "type": "boolean"
        },
        "hideNameTag": {
          "type": "boolean"
        },
        "skin": {
          "$ref": "#/definitions/npcSkin"
        },
        "equipment": {
          "$ref": "#/definitions/npcEquipment"
        }
      },
      "required": [
        "name",
        "pos"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"name\", \"pos\" }",
          "body": {
            "name": "$1",
            "pos": {
              "x": "^$2",
              "y": "^$3",
              "z": "^$4"
            }
          }
        }
      ]
    },
    "color": {
      "type": "string",
      "enum": [
        "Dark Blue",
        "Dark Green",
        "Dark Aqua",
        "Dark Red",
        "Dark Purple",
        "Gold",
        "Gray",
        "Dark Gray",
        "Blue",
        "Green",
        "Aqua",
        "Red",
        "Light Purple",
        "Yellow"
      ]
    },
    "teamImportable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 -]*$"
        },
        "color": {
          "$ref": "#/definitions/color"
        },
        "friendlyFire": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"name\" }",
          "body": {
            "name": "$1"
          }
        }
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Fly": {
          "type": "boolean"
        },
        "Wood Door": {
          "type": "boolean"
        },
        "Iron Door": {
          "type": "boolean"
        },
        "Wood Trap Door": {
          "type": "boolean"
        },
        "Iron Trap Door": {
          "type": "boolean"
        },
        "Fence Gate": {
          "type": "boolean"
        },
        "Button": {
          "type": "boolean"
        },
        "Lever": {
          "type": "boolean"
        },
        "Use Launch Pads": {
          "type": "boolean"
        },
        "/tp": {
          "type": "boolean"
        },
        "/tp Other Players": {
          "type": "boolean"
        },
        "Jukebox": {
          "type": "boolean"
        },
        "Kick": {
          "type": "boolean"
        },
        "Ban": {
          "type": "boolean"
        },
        "Mute": {
          "type": "boolean"
        },
        "Pet Spawning": {
          "type": "boolean"
        },
        "Build": {
          "type": "boolean"
        },
        "Offline Build": {
          "type": "boolean"
        },
        "Fluid": {
          "type": "boolean"
        },
        "Pro Tools": {
          "type": "boolean"
        },
        "Use Chests": {
          "type": "boolean"
        },
        "Use Ender Chests": {
          "type": "boolean"
        },
        "Item Editor": {
          "type": "boolean"
        },
        "Switch Game Mode": {
          "type": "boolean"
        },
        "Edit Variables": {
          "type": "boolean"
        },
        "Change Player Group": {
          "type": "boolean"
        },
        "Change Gamerules": {
          "type": "boolean"
        },
        "Housing Menu": {
          "type": "boolean"
        },
        "Team Chat Spy": {
          "type": "boolean"
        },
        "Edit Actions": {
          "type": "boolean"
        },
        "Edit Regions": {
          "type": "boolean"
        },
        "Edit Scoreboard": {
          "type": "boolean"
        },
        "Edit Event Actions": {
          "type": "boolean"
        },
        "Edit Commands": {
          "type": "boolean"
        },
        "Edit Functions": {
          "type": "boolean"
        },
        "Edit Inventory Layouts": {
          "type": "boolean"
        },
        "Edit Teams": {
          "type": "boolean"
        },
        "Edit Custom Menus": {
          "type": "boolean"
        },
        "View Analytics": {
          "type": "boolean"
        },
        "View Logger": {
          "type": "boolean"
        },
        "Item: Mailbox": {
          "type": "boolean"
        },
        "Item: Egg Hunt": {
          "type": "boolean"
        },
        "Item: Teleport Pad": {
          "type": "boolean"
        },
        "Item: Launch Pad": {
          "type": "boolean"
        },
        "Item: Action Pad": {
          "type": "boolean"
        },
        "Item: Hologram": {
          "type": "boolean"
        },
        "Item: NPCs": {
          "type": "boolean"
        },
        "Item: Action Button": {
          "type": "boolean"
        },
        "Item: Leaderboard": {
          "type": "boolean"
        },
        "Item: Trash Can": {
          "type": "boolean"
        },
        "Item: Biome Stick": {
          "type": "boolean"
        }
      }
    },
    "chatSpeed": {
      "type": "string",
      "enum": [
        "Off",
        "On",
        "Slow 1s",
        "Slow 2s",
        "Slow 3s",
        "Slow 5s",
        "Slow 10s",
        "Slow 15s",
        "Slow 30s",
        "Slow 45s",
        "Slow 60s"
      ]
    },
    "defaultGameMode": {
      "type": "string",
      "enum": [
        "ADVENTURE",
        "SURVIVAL",
        "CREATIVE"
      ]
    },
    "groupImportable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 -]*$"
        },
        "tagShownInChat": {
          "type": "boolean"
        },
        "color": {
          "$ref": "#/definitions/color"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "permissions": {
          "$ref": "#/definitions/permissions"
        },
        "chatSpeed": {
          "$ref": "#/definitions/chatSpeed"
        },
        "defaultGameMode": {
          "$ref": "#/definitions/defaultGameMode"
        }
      },
      "required": [
        "name"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"name\" }",
          "body": {
            "name": "$1"
          }
        }
      ]
    },
    "commandMode": {
      "type": "string",
      "enum": [
        "Self",
        "Targeted"
      ]
    },
    "commandImportable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "actions": {
          "$ref": "#/definitions/htslPath"
        },
        "mode": {
          "$ref": "#/definitions/commandMode"
        },
        "requiredPriority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "listed": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "defaultSnippets": [
        {
          "label": "{ \"name\" }",
          "body": {
            "name": "$1"
          }
        }
      ]
    }
  }
}
