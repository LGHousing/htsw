{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "paths": {
            "htsw-editor-common/project": ["../common/src/project/index.ts"],
            "htsw-editor-common/item/buildItemNbt": ["../common/src/item/buildItemNbt.ts"],
            "htsw-editor-common/text/colorCodes": ["../common/src/text/colorCodes.ts"]
        },
        "types": ["node", "vscode"],
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "react-jsx",

        /* Linting */
        "strict": true
    },
    "include": ["src"]
}
